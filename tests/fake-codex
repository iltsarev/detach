#!/bin/bash

set -u

if [ "${1:-}" = "--version" ]; then
  printf 'codex-cli fake-1.0\n'
  exit 0
fi
# FAKE_CODEX_LEGACY=1 models a release without the shared app-server.
if [ "${1:-}" = "--help" ]; then
  printf 'Usage: codex [OPTIONS] [PROMPT]\n'
  [ "${FAKE_CODEX_LEGACY:-0}" = 1 ] || \
    printf '      --no-daemon  Run without the shared background server\n'
  exit 0
fi

cwd="$PWD"
mode="start"
source="${FAKE_CODEX_SOURCE:-cli}"
case "$source" in cli|vscode) ;; *) exit 2 ;; esac
resume_id=""
no_daemon=0
args_file="${FAKE_CODEX_ARGS_FILE:?}"
codex_home="${CODEX_HOME:?}"

sqlite() {
  sqlite3 -cmd '.timeout 5000' "$@"
}

printf '%s\n' "$@" >"$args_file"
if [ -t 0 ]; then
  stty size >"$args_file.terminal-size"
  printf '%s\n' "${DETACH_INITIAL_TERMINAL_SIZE:-}" >"$args_file.initial-size-hint"
fi
if [ -n "${FAKE_CODEX_COLORTERM_FILE:-}" ]; then
  printf '%s\n' "${COLORTERM:-}" >"$FAKE_CODEX_COLORTERM_FILE"
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    -C|--cd)
      cwd="$2"
      shift 2
      ;;
    --no-daemon)
      no_daemon=1
      shift
      ;;
    resume)
      mode="resume"
      resume_id="${2:-}"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

mkdir -p "$codex_home/sessions/2099/01/01"
db="$codex_home/state_5.sqlite"
now_ms="$(printf '%s000' "$(date '+%s')")"
sqlite "$db" 'CREATE TABLE IF NOT EXISTS threads (id TEXT PRIMARY KEY, rollout_path TEXT NOT NULL, created_at_ms INTEGER, updated_at_ms INTEGER, source TEXT, thread_source TEXT, cwd TEXT);'

if [ "${FAKE_CODEX_FOREIGN_FIRST:-0}" = "1" ]; then
  foreign_id="ffffffff-ffff-4fff-8fff-ffffffffffff"
  foreign_rollout="$codex_home/sessions/2099/01/01/rollout-foreign-$foreign_id.jsonl"
  printf '{"timestamp":"2099-01-01T00:00:00Z","type":"session_meta","payload":{"id":"%s","cwd":"%s","originator":"codex_cli_rs"}}\n' \
    "$foreign_id" "$cwd" >"$foreign_rollout"
  escaped_foreign_rollout="${foreign_rollout//\'/\'\'}"
  escaped_foreign_cwd="${cwd//\'/\'\'}"
  sqlite "$db" "INSERT OR REPLACE INTO threads (id, rollout_path, created_at_ms, updated_at_ms, source, thread_source, cwd) VALUES ('$foreign_id', '$escaped_foreign_rollout', $now_ms, $now_ms, '$source', 'user', '$escaped_foreign_cwd');"
fi

sleep "${FAKE_CODEX_INIT_DELAY:-0}"

if [ "$mode" = "resume" ] && [ -n "$resume_id" ] && [ "$resume_id" != "--last" ]; then
  id="$resume_id"
else
  id="00000000-0000-7000-8000-$(printf '%012d' $$)"
fi

rollout="$codex_home/sessions/2099/01/01/rollout-test-$id.jsonl"
originator="${CODEX_INTERNAL_ORIGINATOR_OVERRIDE:-codex_cli_rs}"
# Without --no-daemon, a running shared app-server creates the thread. The
# thread gets the originator of the process that started that daemon.
if [ "$no_daemon" = 0 ] && [ "${FAKE_CODEX_LEGACY:-0}" != 1 ] && \
   [ -n "${FAKE_CODEX_DAEMON_ORIGINATOR:-}" ]; then
  originator="$FAKE_CODEX_DAEMON_ORIGINATOR"
fi
# An inherited provider environment can name another run's originator even
# without a shared daemon.
[ -z "${FAKE_CODEX_FORCE_ORIGINATOR:-}" ] || originator="$FAKE_CODEX_FORCE_ORIGINATOR"
if [ "${FAKE_CODEX_GUARDIAN:-0}" = 1 ]; then
  # Review companions inherit the run originator. Neither their client source
  # nor their originator makes them the user's conversation.
  for guardian_source in vscode '{"subagent":{"other":"guardian"}}'; do
    case "$guardian_source" in
      vscode) guardian_id="aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa" ;;
      *) guardian_id="bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb" ;;
    esac
    guardian_rollout="$codex_home/sessions/2099/01/01/rollout-guardian-$guardian_id.jsonl"
    printf '{"type":"session_meta","payload":{"id":"%s","cwd":"%s","originator":"%s"}}\n' \
      "$guardian_id" "$cwd" "$originator" >"$guardian_rollout"
    escaped_guardian_rollout="${guardian_rollout//\'/\'\'}"
    escaped_guardian_cwd="${cwd//\'/\'\'}"
    sqlite "$db" "INSERT OR REPLACE INTO threads (id, rollout_path, created_at_ms, updated_at_ms, source, thread_source, cwd) VALUES ('$guardian_id', '$escaped_guardian_rollout', $now_ms, $now_ms, '$guardian_source', 'guardian_review', '$escaped_guardian_cwd');"
  done
fi
printf '{"timestamp":"2099-01-01T00:00:00Z","type":"session_meta","payload":{"id":"%s","cwd":"%s","originator":"%s","source":"%s"}}\n' \
  "$id" "$cwd" "$originator" "$source" >"$rollout"
printf '{"timestamp":"2099-01-01T00:00:01Z","type":"event_msg","payload":{"type":"task_started","turn_id":"fake-turn-%s"}}\n' \
  "$id" >>"$rollout"

escaped_cwd="${cwd//\'/\'\'}"
escaped_rollout="${rollout//\'/\'\'}"
sqlite "$db" "INSERT OR REPLACE INTO threads (id, rollout_path, created_at_ms, updated_at_ms, source, thread_source, cwd) VALUES ('$id', '$escaped_rollout', $now_ms, $now_ms, '$source', 'user', '$escaped_cwd');"

printf 'fake Codex started in %s\n' "$cwd"
printf 'mode=%s id=%s\n' "$mode" "$id"
if [ "$COLORTERM" = truecolor ]; then
  printf '\033[38;2;12;34;56mtrue-color checkpoint probe\033[0m\n'
fi
if [ -n "${FAKE_CODEX_RELEASE_FILE:-}" ]; then
  case "$FAKE_CODEX_RELEASE_FILE" in
    /*) ;;
    *) printf 'fake Codex release file must be absolute\n' >&2; exit 2 ;;
  esac
  release_attempts=0
  while { [ ! -f "$FAKE_CODEX_RELEASE_FILE" ] || [ -L "$FAKE_CODEX_RELEASE_FILE" ]; } && \
        [ "$release_attempts" -lt 600 ]; do
    release_attempts=$((release_attempts + 1))
    sleep 0.1
  done
  if [ ! -f "$FAKE_CODEX_RELEASE_FILE" ] || [ -L "$FAKE_CODEX_RELEASE_FILE" ]; then
    printf 'timed out waiting for fake Codex release file\n' >&2
    exit 124
  fi
else
  sleep "${FAKE_CODEX_SLEEP:-4}"
fi
printf '{"timestamp":"2099-01-01T00:05:00Z","type":"event_msg","payload":{"type":"agent_message","message":"checkpoint me"}}\n' >>"$rollout"
printf 'fake Codex finished\n'
exit "${FAKE_CODEX_EXIT:-7}"
